{
  "name": "copper-ai-axxess-integration",
  "version": "1.0.0",
  "description": "Axxess integration for Copper AI voice agents (direct API access)",
  "keywords": [
    "api-integration",
    "axxess",
    "copper-ai",
    "evv",
    "home-health",
    "voice-ai"
  ],
  "license": "MIT",
  "author": "Nike 🐾",
  "main": "axxess-api-client.js",
  "scripts": {
    "check:api": "node scripts/check-api-status.js",
    "db:migrate": "psql $DATABASE_URL -f database-migrations.sql",
    "db:rollback": "psql $DATABASE_URL -c 'DROP TABLE IF EXISTS axxess_sync_log CASCADE; DROP TABLE IF EXISTS axxess_rate_limits CASCADE;'",
    "dev": "nodemon webhook-server.js",
    "start": "node webhook-server.js",
    "sync:caregivers": "node scripts/sync-axxess-caregivers.js",
    "sync:schedule": "node scripts/sync-axxess-schedule.js",
    "test": "node axxess-api-client.js"
  },
  "dependencies": {
    "axios": "^1.6.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
