# Copper AI Axxess Integration - Environment Variables
# Copy this to .env and fill in your values

# Server
PORT=3000
NODE_ENV=production

# Database (PostgreSQL) - SHARED with ClearCare integration
DATABASE_URL=postgresql://username:password@host:5432/copper_ai

# Axxess API (OAuth 2.0)
AXXESS_CLIENT_ID=your_axxess_client_id_from_axxess_support
AXXESS_CLIENT_SECRET=your_axxess_client_secret_from_axxess_support
AXXESS_AGENCY_ID=AG-12345
AXXESS_API_URL=https://api.axxess.com/v1

# Retell API (Voice AI) - SHARED with ClearCare
RETELL_API_KEY=your_retell_api_key_here
RETELL_AGENT_ID=your_default_agent_id

# Twilio (SMS backup alerts) - SHARED with ClearCare
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+14697421095

# Telegram Alerts - SHARED with ClearCare
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
ARVIND_TELEGRAM_ID=7372113399

# Webhook Security - SHARED with ClearCare
CRON_SECRET=random_secret_for_cron_endpoint

# Optional: Logging
LOG_LEVEL=info
LOG_API_CALLS=true
