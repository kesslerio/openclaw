# Copper AI ClearCare Integration - Environment Variables
# Copy this to .env and fill in your values

# Server
PORT=3000
NODE_ENV=production

# Database (PostgreSQL)
DATABASE_URL=postgresql://username:password@host:5432/copper_ai

# Retell API (Voice AI)
RETELL_API_KEY=your_retell_api_key_here
RETELL_AGENT_ID=your_default_agent_id

# Twilio (SMS backup alerts)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+14697421095

# Telegram Alerts
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
ARVIND_TELEGRAM_ID=7372113399

# Webhook Security
ZAPIER_WEBHOOK_SECRET=random_secret_generate_this_securely
CRON_SECRET=another_random_secret_for_cron_endpoint

# Optional: Logging
LOG_LEVEL=info
