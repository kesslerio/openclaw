{
  "name": "copper-ai-unified-server",
  "version": "1.0.0",
  "description": "Unified integration server for Copper AI voice agents (ClearCare + Axxess + more)",
  "keywords": [
    "axxess",
    "clearcare",
    "copper-ai",
    "evv",
    "home-health",
    "unified",
    "voice-ai"
  ],
  "license": "MIT",
  "author": "Nike 🐾",
  "main": "server.js",
  "scripts": {
    "db:reset": "psql $DATABASE_URL -c 'DROP SCHEMA public CASCADE; CREATE SCHEMA public;' && npm run db:setup",
    "db:setup": "psql $DATABASE_URL -f ../clearcare/database-schema.sql && psql $DATABASE_URL -f ../axxess/database-migrations.sql",
    "dev": "nodemon server.js",
    "start": "node server.js",
    "test": "echo 'Tests coming soon' && exit 0"
  },
  "dependencies": {
    "axios": "^1.6.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
